<Application x:Class="ClawStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#171717"/>
    <SolidColorBrush x:Key="Panel" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Panel2" Color="#252526"/>
    <SolidColorBrush x:Key="Border" Color="#33373D"/>
    <SolidColorBrush x:Key="Text" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="Muted" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="Accent" Color="#60A5FA"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2F3640"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#2B2B2E"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#2B2B2E"/>
      <Setter Property="Foreground" Value="Black"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="Margin" Value="4"/>
    </Style>
  </Application.Resources>
</Application>
